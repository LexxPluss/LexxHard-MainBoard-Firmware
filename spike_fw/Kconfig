# STM32 HAL modules used directly by actuator_controller.cpp (HAL_TIM_Encoder_*,
# HAL_TIMEx_MasterConfigSynchronization, HAL_GPIO_Init). They are hidden symbols,
# so they can only be enabled by a select.
config LEXXHARD_STM32_HAL_APP
	bool
	default y
	select USE_STM32_HAL_TIM
	select USE_STM32_HAL_TIM_EX
	select USE_STM32_HAL_GPIO

config LEXXHARD_MICROROS_NO_EXECUTOR
	bool "Replace the rclc executor by a plain rcl wait-set loop"
	default n
	help
	  Size measurement only: the micro-ROS sample uses a hand-written rcl wait-set loop
	  instead of the rclc executor, so that rclc executor.c and the rcl_action code that
	  it references are not linked.

source "Kconfig.zephyr"
