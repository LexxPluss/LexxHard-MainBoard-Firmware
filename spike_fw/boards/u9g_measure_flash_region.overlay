/*
 * MEASUREMENT ONLY: the code partition is enlarged to 512 KiB so that the image links and its size can be
 * measured. The real slot is 256 KiB and the firmware plus micro-ROS overflowed it by 13316 bytes at the
 * first link. The image signer takes the slot size from slot1_partition, so that one is enlarged too.
 * Both overlap their neighbours (slot1 overlaps scratch): never use for a release image.
 */
&slot0_partition {
	reg = <0x00040000 0x00080000>;
};

&slot1_partition {
	reg = <0x00080000 0x00080000>;
};
